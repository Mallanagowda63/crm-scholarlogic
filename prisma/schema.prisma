// Phase 1 only defines what authentication needs. The CRM schema arrives in Phase 2.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// One of ROLES in src/lib/roles.ts. SQLite has no enum type.
  role         String   @default("VIEWER")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
