    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.66.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
