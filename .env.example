# Password for the Postgres container in docker-compose.yml.
POSTGRES_PASSWORD="change-me"

# Must use the same password as POSTGRES_PASSWORD.
DATABASE_URL="postgresql://scholarlogic:change-me@localhost:5433/scholarlogic"

# Signs session cookies. Generate one with: npx auth secret
AUTH_SECRET=""

# Required by `next start` and when running behind a proxy.
AUTH_TRUST_HOST=true
